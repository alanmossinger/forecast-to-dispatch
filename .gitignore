# Environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Data — only the committed sample ships with the repo
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model binaries — metadata (metrics JSON, registry) is tracked, weights are not
models/*.pkl
models/*.pt
models/*.txt
models/**/*.pkl
models/**/*.pt
# CI/sample smoke-test models are ephemeral by design
models/sample/

# Governance runtime state (append-only audit JSONL, approvals, gate verdicts)
# The generated model_card.md and risk_register.md ARE committed.
governance/audit_log.jsonl
governance/approvals.json
governance/gate_status.json

# Notebook checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
